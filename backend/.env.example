# Database
# SQLite (default — no setup needed, just a local file):
DATABASE_URL=sqlite:///./apartment.db
# PostgreSQL (switch to this when the team sets up a shared DB):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/apartment_db

# App
APP_NAME=Jains Kences Retreat - Apartment Association Management System
APP_VERSION=1.0.0
DEBUG=True

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (for future JWT auth)
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Optional AI provider (BE-41) ──────────────────────────────────────────────
# LEAVE THIS BLOCK COMMENTED OUT. The AI analytics layer is fully functional
# without it: every figure it reports (trend, anomalies, forecast, risk score)
# is computed on the server with plain statistics, offline, at zero cost. A
# model is used ONLY to reword the summary sentence, never to produce a number,
# and any failure falls straight back to the deterministic text. The response
# field `summary_source` tells you which path ran ("template" or "llm").
#
# Option A — Ollama (recommended if you want this at all: local, free, no key)
#   brew install ollama && ollama pull llama3.2
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.2
#
# Option B — any OpenAI-compatible endpoint (Groq, Gemini, ... free tiers)
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant
# AI_API_KEY=your-key-here
#
# NEVER put a real key in this file — .env.example is committed to git.
# Put it in .env, which is gitignored.

# ── AI assistant (BE-41 / BE-42) ─────────────────────────────────────────────
# Optional. Leave AI_PROVIDER empty and everything still works: the assistant
# falls back to a deterministic intent engine and the analytics layer to its
# own templates. Nothing here is needed to run or test the project.
#
# With a provider set, the model becomes the assistant's *understanding*
# layer — it reads a message and picks an intent. It still cannot act: the
# role check, the missing-detail prompt and the user's confirmation all sit
# downstream of it, and it never computes an analytics figure.
#
# Google AI Studio, free tier (https://aistudio.google.com/apikey). It speaks
# the OpenAI protocol, so no SDK is needed:
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-key-here
# AI_MODEL=gemini-flash-lite-latest
#
# Model names move: if you get "model is no longer available", list what your
# key can see with
#   curl -H "Authorization: Bearer $AI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/openai/models
#
# Or run a local model instead, with no key and no quota:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.2

# Where the assistant calls itself when looking something up for a user. It
# goes back through HTTP on purpose so the endpoint's own auth and role checks
# still apply. Change the port here if you serve the API somewhere else.
# SELF_BASE_URL=http://127.0.0.1:8000

# Login tokens last this long. 30 is fine for development; raise it if you are
# demonstrating and do not want to be signed out mid-way.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
